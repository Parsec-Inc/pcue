<?xml version="1.0" encoding="UTF-8"?>
<!-- MSI por usuário: instala em %LOCALAPPDATA%\Programs\pcue e põe no PATH, sem pedir admin.
     Assim o `pcue update` troca o executável sem UAC. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="pcue" Language="1033" Version="$(var.Version)" Manufacturer="Parsec-Inc"
           UpgradeCode="01a1eb30-22af-7075-bf5d-47853469dfff">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" Platform="x64" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer pcue is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="pcue" />
        </Directory>
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Main" Guid="01a1eb30-22af-7075-bf5d-47860df44a60" Win64="yes">
        <File Id="PcueExe" Name="pcue.exe" Source="$(var.Exe)" />
        <RegistryValue Root="HKCU" Key="Software\Parsec-Inc\pcue" Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
        <Environment Id="UserPath" Name="PATH" Value="[INSTALLDIR]" Part="last" Action="set" System="no" />
        <RemoveFolder Id="RemoveInstallDir" Directory="INSTALLDIR" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
    </DirectoryRef>

    <Feature Id="Default" Level="1">
      <ComponentRef Id="Main" />
    </Feature>
  </Product>
</Wix>
